{
  "expo": {
    "name": "CrisisOS",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "extra": {
      "backendUrl": "http://10.245.105.189:8000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.crisisai.r45r8y"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.emergent.crisisai.r45r8y"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Share your location so responders can reach you during an SOS."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Attach a photo so responders can see the emergency scene.",
          "cameraPermission": "Take a photo so responders can see the emergency scene."
        }
      ],
      "expo-web-browser",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}